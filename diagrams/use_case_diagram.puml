@startuml
!theme plain

left to right direction

actor "Member" as member
actor "Receptionist" as receptionist
actor "Worker" as worker
actor "System" as system

rectangle "Car Rental System" {
  usecase "Search Catalog" as UC1
  usecase "Register New Account" as UC2
  usecase "Cancel Membership" as UC3
  usecase "Reserve Vehicle" as UC4
  usecase "Check-out Vehicle" as UC5
  usecase "Return Vehicle" as UC6
  usecase "Add/Remove/Edit Vehicle" as UC7
  usecase "Add Equipment" as UC8
  usecase "Add Service" as UC9
  usecase "Add Insurance" as UC10
  usecase "Update Vehicle Log" as UC11
  usecase "Send Notification" as UC12
  usecase "Generate Bill" as UC13
  usecase "Cancel Reservation" as UC14
}

member --> UC1
member --> UC2
member --> UC3
member --> UC4
member --> UC5
member --> UC6
member --> UC8
member --> UC9
member --> UC10
member --> UC14

receptionist --> UC2
receptionist --> UC7
receptionist --> UC4

worker --> UC6
worker --> UC11

system --> UC12
system --> UC13

UC4 .> UC12 : <<include>>
UC5 .> UC13 : <<include>>
UC6 .> UC13 : <<include>>
UC6 .> UC11 : <<include>>

@enduml
